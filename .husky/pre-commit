#!/usr/bin/env sh

set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|css|scss|md|mjs|cjs|yml|yaml)$' || true)"

if [ -n "$staged_files" ]; then
  if ! printf '%s\n' "$staged_files" | xargs npx prettier --check; then
    echo "❌ Prettier check failed. Please run: npx prettier --write <staged files>"
    exit 1
  fi
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
ticketed_pattern='^(feature|fix|hotfix|release|remove)\/KPC-[0-9]{3,4}$'
release_train_pattern='^release\/[0-9]+-keen$'

if printf '%s' "$branch" | grep -Eq "$ticketed_pattern|$release_train_pattern"; then
  exit 0
else
  echo "❌ Push blocked. Branch '$branch' doesn't match an allowed pattern."
  echo "   Allowed: <feature|fix|hotfix|release|remove>/KPC-<NUMBER: 3-4 digits>"
  echo "   Allowed: release/<NUMBER>-keen"
  echo "   e.g. feature/KPC-1234"
  echo "   e.g. release/13-keen"
  exit 1
fi
